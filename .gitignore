# ── Python ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

# ── Runtime artifacts (generated by demo.py / server) ───
# Encrypted file packages stored by the server
server/storage/

# Downloaded & decrypted files
client/downloads/

# SQLite database
server/db/

# ── Log files ────────────────────────────────────────────
ca/logs/
server/logs/
client/logs/

# ── Certificates & keys (generated on first run) ─────────
# CA keys and cert
ca/ca_private_key.pem
ca/ca_cert.pem

# Server keys and cert
server/server_private_key.pem
server/server_cert.pem
server/ca_cert.pem

# Client identities (keys + certs per user)
client/identities/

# ── OS / editor junk ─────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
.idea/
